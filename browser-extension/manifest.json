{
  "manifest_version": 3,
  "name": "Axiom Browser Boundary",
  "version": "0.1.1",
  "description": "Local destination-aware multipart upload gate and a block-all Gmail file-drop guard.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Axiom browser protection"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
